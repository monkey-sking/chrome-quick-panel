{
  "manifest_version": 3,
  "name": "书签 / 历史 快捷面板",
  "version": "1.1.0",
  "description": "点击工具栏图标，在书签面板和历史面板之间交替打开。",
  "minimum_chrome_version": "120",
  "permissions": [
    "tabs",
    "bookmarks",
    "sessions",
    "storage",
    "contextMenus",
    "favicon"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "书签 / 历史（点击交替切换）",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "open-history-panel": {
      "suggested_key": {
        "default": "Alt+Shift+H",
        "mac": "Command+Shift+Y"
      },
      "description": "打开历史记录面板"
    },
    "open-bookmarks-panel": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "Command+Shift+U"
      },
      "description": "打开书签面板"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
